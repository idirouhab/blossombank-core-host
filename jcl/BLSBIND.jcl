//BLSBIND JOB (078,DBA),'ONLINE PACKAGE',CLASS=A,MSGCLASS=X
//BIND     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DB2.RUNTIME.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=BLS.CORE.DBRMLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DBL1)
  BIND PACKAGE(BLSONL) MEMBER(ACCTGET) -
       ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) -
       OWNER(BLSOWNER) QUALIFIER(BLSCORE) RELEASE(COMMIT)
  BIND PACKAGE(BLSONL) MEMBER(POSTING) -
       ACTION(REPLACE) ISOLATION(RR) VALIDATE(BIND) -
       OWNER(BLSOWNER) QUALIFIER(BLSCORE) RELEASE(COMMIT)
  BIND PLAN(BLSONL1) PKLIST(BLSONL.*) -
       ACTION(REPLACE) RETAIN
  END
/*
